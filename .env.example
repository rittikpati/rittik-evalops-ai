# RittikEvalOpsAI — OpenRouter Integration (next step)
# Do NOT commit real keys. Copy this to .env.local and fill.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY= YOUR_REAL_OPENROUTER_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://rittikevalops.ai
OPENROUTER_APP_NAME=RittikEvalOpsAI

# Optional: force provider (mock | openrouter). Defaults to mock when key missing.
AI_PROVIDER=mock

# Optional: default judge model for evaluations
JUDGE_MODEL_ID=openai/gpt-4o

# Session secret for HMAC-SHA256 signed cookies (also used by Auth.js to sign
# its OAuth session cookies — same value, shared).
# REQUIRED in production. Generate a long random string (32+ chars).
# Example: openssl rand -base64 32
AUTH_SECRET=

# Application origin Auth.js redirects back to (defaults to the request origin).
# Set explicitly in production, e.g. https://rittikevalops.ai
AUTH_URL=

# Supabase (Phase 17B — FREE-tier database foundation)
# Supervised in the project settings, never committed with real values.

# Server-side only Postgres connection string (Project Settings -> Database).
# NEVER expose this to the client. Use "Direct connection" or Session pooler URL.
# Example format (unpooled): postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Public Supabase URL + anon key. These are PUBLIC by design (safe to ship to
# the browser), not secrets. Fill real values from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key